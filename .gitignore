# ILEP .gitignore

# ============================================
# SENSITIVE DATA - Never commit real student data
# ============================================
Data/
data/
*.csv

# ============================================
# Java Compiled Files
# ============================================
*.class
*.jar
*.war
*.ear
bin/
target/
build/

# ============================================
# IDE Specific Files
# ============================================

# Eclipse
.classpath
.project
.settings/
.metadata/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# ============================================
# Operating System Files
# ============================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ============================================
# Logs and Temporary Files
# ============================================
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# ============================================
# Package Files
# ============================================
*.zip
*.tar.gz
*.rar

# ============================================
# Test Data (if you create test fixtures)
# ============================================
TestData/
test-data/
*.test.csv

# ============================================
# Documentation Build Files
# ============================================
docs/_build/
site/